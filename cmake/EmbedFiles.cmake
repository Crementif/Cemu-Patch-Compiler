# Embeds files into the executable, so patch code can include clang's freestanding headers, libc++ and the patch
# runtime without anything installed next to the compiler.

# Adds the files of sourceDir that match the patterns to the list in outVar, under virtualDir. Patterns without
# wildcards must exist. With RECURSE, wildcards also match in subdirectories.
function(embed_collect outVar virtualDir sourceDir)
    cmake_parse_arguments(PARSE_ARGV 3 arg "RECURSE" "" "FILES")
    set(globs)
    foreach(pattern IN LISTS arg_FILES)
        if(NOT pattern MATCHES "[*?]" AND NOT EXISTS "${sourceDir}/${pattern}")
            message(FATAL_ERROR "${sourceDir}/${pattern} not found")
        endif()
        list(APPEND globs "${sourceDir}/${pattern}")
    endforeach()
    if(arg_RECURSE)
        file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${sourceDir}" ${globs})
    else()
        file(GLOB files LIST_DIRECTORIES false RELATIVE "${sourceDir}" ${globs})
    endif()
    list(SORT files)
    set(entries ${${outVar}})
    foreach(file IN LISTS files)
        list(APPEND entries "${virtualDir}/${file}=${sourceDir}/${file}")
    endforeach()
    set(${outVar} ${entries} PARENT_SCOPE)
endfunction()

# Writes the collected files to outputFile as kEmbeddedFiles, a list of {virtual path, chunk} pairs. MSVC limits a
# string literal to 64 KB, so each file is split into chunks that follow each other under the same path.
function(embed_write outputFile entries)
    set(content "#pragma once\n\n// Generated by cmake/EmbedFiles.cmake\n\n")
    string(APPEND content "inline constexpr std::pair<std::string_view, std::string_view> kEmbeddedFiles[] = {\n")
    foreach(entry IN LISTS entries)
        string(FIND "${entry}" "=" separator)
        string(SUBSTRING "${entry}" 0 ${separator} virtualPath)
        math(EXPR pathStart "${separator} + 1")
        string(SUBSTRING "${entry}" ${pathStart} -1 path)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
        file(READ "${path}" text)
        string(LENGTH "${text}" length)
        if(length EQUAL 0)
            string(APPEND content "    {\"${virtualPath}\", \"\"},\n")
        endif()
        set(offset 0)
        while(offset LESS length)
            string(SUBSTRING "${text}" ${offset} 8192 chunk)
            string(APPEND content "    {\"${virtualPath}\", R\"CEMU_EMBED(${chunk})CEMU_EMBED\"},\n")
            math(EXPR offset "${offset} + 8192")
        endwhile()
    endforeach()
    string(APPEND content "};\n")
    file(WRITE "${outputFile}.tmp" "${content}")
    file(COPY_FILE "${outputFile}.tmp" "${outputFile}" ONLY_IF_DIFFERENT)
    file(REMOVE "${outputFile}.tmp")
endfunction()
